# Скопируйте этот файл в .env и заполните.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAAA-ваш-токен

# Ваш Telegram ID (узнать у @userinfobot). Админ видит /stats и может /reload.
# Несколько — через запятую.
ADMIN_IDS=123456789

# Код доступа для конструкторов. Пусто — бот открыт всем, кто его найдёт.
ACCESS_CODE=

# Час (по времени компьютера), когда приходит «вопрос дня»
DAILY_HOUR=9
